---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const steps: Array<{ icon: string; title: string; desc: string }> = t(locale, 'how.steps', true);
---

<section class="section" id="como-trabajamos">
  <div class="container">
    <div class="section-head">
      <span class="section-kicker">{t(locale, 'how.kicker')}</span>
      <h2 class="section-title">{t(locale, 'how.heading')}</h2>
      <p class="section-sub">{t(locale, 'how.subtitle')}</p>
    </div>

    <div class="steps-grid">
      {
        steps.map((step, i) => (
          <article class="card step-card reveal">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="card-icon">
              <Icon name={step.icon as any} />
            </div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>