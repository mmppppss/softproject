---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items: Array<{ icon: string; title: string; desc: string }> = t(
  locale,
  'audience.items',
  true,
);
---

<section class="section" id="a-quien-ayudamos">
  <div class="container">
    <div class="section-head">
      <span class="section-kicker">{t(locale, 'audience.kicker')}</span>
      <h2 class="section-title">{t(locale, 'audience.heading')}</h2>
      <p class="section-sub">{t(locale, 'audience.subtitle')}</p>
    </div>

    <div class="card-grid">
      {
        items.map((item) => (
          <article class="card reveal">
            <div class="card-icon">
              <Icon name={item.icon as any} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>