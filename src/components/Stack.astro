---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups: Array<{ name: string; items: string[] }> = t(locale, 'stack.groups', true);
---

<section class="section" id="stack">
  <div class="container">
    <div class="section-head">
      <span class="section-kicker">{t(locale, 'stack.kicker')}</span>
      <h2 class="section-title">{t(locale, 'stack.heading')}</h2>
      <p class="section-sub">{t(locale, 'stack.subtitle')}</p>
    </div>

    <div>
      {
        groups.map((group) => (
          <div class="stack-group reveal">
            <h3>{group.name}</h3>
            <div class="chips">
              {group.items.map((item) => <span class="chip">{item}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>