---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import siteConfig from '../site.config';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/themes/theme-emerald.css';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale } = Astro.props;
const title = Astro.props.title ?? t(locale, 'meta.title');
const description = Astro.props.description ?? t(locale, 'meta.description');
const canonical = `${siteConfig.url}${locale === siteConfig.defaultLocale ? '' : '/' + locale}/`;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" viewport-fit="cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#061512" />
    <meta name="description" content={description} />
	<meta name="color-scheme" content={locale === 'es' ? 'dark light' : 'dark light'} />
	<meta property="og:image" content="/logotipo.svg">

    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('sp-theme');
          var theme = stored === 'light' || stored === 'dark' ? stored : null;
          if (!theme) {
            theme =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div class="background" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <main id="inicio">
      <Navbar locale={locale} />
      <slot />
      <Footer locale={locale} />
    </main>
  </body>
</html>
